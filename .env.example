# Skopiuj do .env i uzupełnij. Plik .env jest w .gitignore.
OPENROUTER_API_KEY=sk-or-...

# Opcjonalne nadpisania (wartości domyślne poniżej)
CA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
CA_TEMPERATURE=0.2
CA_MAX_TOKENS=8000
CA_TIMEOUT=180
# none | json_object | json_schema  (walidacja Pydantic działa zawsze, niezależnie od trybu)
CA_RESPONSE_FORMAT=none
# low | medium | high, puste = domyślne ustawienie modelu
CA_REASONING_EFFORT=
CA_MAX_ATTEMPTS=3
